# Copy to .env (git-ignored, don't commit it).
# docker-compose reads DB_USERNAME / DB_PASSWORD / DB_NAME for the db service.
# The backend reads all of it when you run it without Docker (python api.py).

DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=secret
DB_NAME=postgres

# Ollama runs on the host. Without Docker the backend uses http://localhost:11434,
# in Docker it uses http://host.docker.internal:11434. Leave this unset unless Ollama runs
# on another machine: docker-compose passes it into the container too, where "localhost"
# is the container itself.
# OLLAMA_HOST=http://192.168.1.10:11434

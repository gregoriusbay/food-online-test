# Copy to .env and fill in ONE provider block.  (.env is git-ignored — never commit keys)

# --- Option A: Google Gemini (has a free tier) via its OpenAI-compatible endpoint ---
# Key: https://aistudio.google.com/apikey
# Model names change often — check https://ai.google.dev/gemini-api/docs/models
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your-gemini-key
LLM_MODEL=gemini-2.5-flash

# --- Option B: OpenAI ---
# LLM_BASE_URL=
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# --- Option C: Local Ollama (no key; needs a vision model, e.g. `ollama pull qwen2.5vl`) ---
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5vl

# Optional: a different (stronger) model just for receipt extraction
# VISION_MODEL=

OCR_ENABLED=true
APP_TIMEZONE=Asia/Jakarta

DB_DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=secret
DB_NAME=golang_practice
